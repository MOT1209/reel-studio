    "build-icons": "node tools/build-icons.mjs",
    "test": "node tools/unit.mjs && node tools/longform-test.mjs && node tools/concat-test.mjs && node tools/arabic-test.mjs && node tools/library-test.mjs && node tools/skills-test.mjs && node tools/vault-test.mjs && node tools/voice-test.mjs && node tools/engines-test.mjs && node tools/robustness.mjs && node tools/phase1-test.mjs && node tools/webhooks-test.mjs",
    "test:longform": "node tools/longform-test.mjs",
    "test:concat": "node tools/concat-test.mjs",
    "test:longform-e2e": "node tools/longform-e2e.mjs",
    "test:library": "node tools/library-test.mjs",
    "test:arabic": "node tools/arabic-test.mjs",
    "test:unit": "node tools/unit.mjs",
    "test:robustness": "node tools/robustness.mjs",
    "e2e": "node tools/e2e.mjs",
    "templates": "node tools/templates-test.mjs",
    "test:export": "node tools/export-test.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "test:all": "npm test && npm run e2e && npm run test:longform-e2e && npm run test:export && npm run test:remotion && npm run test:ui && npm run test:xss && npm run test:a11y && npm run test:arabic-video && npm run templates",
    "test:skills": "node tools/skills-test.mjs",
    "test:vault": "node tools/vault-test.mjs",
    "test:voice": "node tools/voice-test.mjs",
    "test:engines": "node tools/engines-test.mjs",
    "test:remotion": "node tools/remotion-test.mjs",
    "test:phase1": "node tools/phase1-test.mjs",
    "test:webhooks": "node tools/webhooks-test.mjs",
    "test:xss": "node tools/xss-test.mjs",
    "test:arabic-video": "node tools/arabic-video-test.mjs",
    "test:a11y": "node tools/a11y-test.mjs",
    "test:perf": "node tools/perf-test.mjs",
    "test:lowmem": "node tools/lowmem-test.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.546",
    "@remotion/renderer": "4.0.546",
    "ajv": "8.20.0",
    "playwright": "^1.49.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.546",
    "svix": "1.99.1"
  }
}
