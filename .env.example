# Copy to .env — values here are fallbacks; keys saved in the Settings screen (data/settings.json) win.
# Base URLs set here ALWAYS win (used to point the app at tools/mock-apis.mjs).

# LLM — FreeLLMAPI (https://github.com/tashfeenahmed/freellmapi) or any OpenAI-compatible API
# LLM_BASE_URL=http://127.0.0.1:31415/v1
LLM_API_KEY=
LLM_MODEL=auto

# ElevenLabs — https://elevenlabs.io/app/developers/
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Deepgram (word timings for an uploaded voice-over) — https://console.deepgram.com/
# DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_API_KEY=

# Optional
# FONT_FOLDER=C:\Fonts\MyArabicFont
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# RS_PORT=4301
# RS_RENDER_WORKERS=3          # parallel browser pages while rendering
# RS_CAPTURE=screenshot        # capture frames with page screenshots instead of the canvas

# Stock media (optional — Settings → المكتبات)
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# PEXELS_BASE_URL / PIXABAY_BASE_URL / UNSPLASH_BASE_URL — only to point at tools/mock-apis.mjs

# YouTube (optional — Settings → يوتيوب)
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# LLM_IDLE_TIMEOUT_MS=120000   # abort an LLM call that stays silent this long

# Secrets encryption (optional): a base64 32-byte master key from your own keychain/launcher;
# when set, no key file is written. On Windows the key is otherwise protected with DPAPI automatically.
# RS_VAULT_KEY=
